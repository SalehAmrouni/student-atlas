# Optional. Student Atlas runs without any keys; these turn on shared reviews
# and College Lab AI feedback.
# PORT=3000

# Accounts, school rooms, and reviews: Supabase Postgres (see README). Without
# these, they're off in production and use a temporary in-process database
# when running `npm run dev`. The secret key is server-only: never expose it.
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SECRET_KEY=
# (SUPABASE_SERVICE_ROLE_KEY also works in place of SUPABASE_SECRET_KEY.)

# Set this to a long random string once and never change it (it hashes
# sign-in codes). Moving from Redis? Keep the value the site used before.
# ACCOUNTS_SALT=

# Only for scripts/migrate-redis-to-supabase.js (the old Upstash Redis store).
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Moderator token for /moderate (at least 16 characters, keep it secret).
# REVIEWS_ADMIN_TOKEN=

# Optional: a long random string used to hash visitor IPs for rate limits.
# REVIEWS_SALT=

# Optional: set to "all" to hold every review until a moderator approves it.
# REVIEWS_MODERATION=

# College Lab AI feedback (essays, transcripts, mentor). Without a key the
# College Lab uses its on-device engine. Set these in Vercel under
# Settings -> Environment Variables; never commit a real key.
# ANTHROPIC_API_KEY=
# COLLEGE_LAB_MODEL=claude-opus-5-5
# COLLEGE_LAB_RATE_LIMIT=30
