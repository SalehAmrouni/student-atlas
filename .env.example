# Optional. Student Atlas runs without any keys; these only turn on shared reviews.
# PORT=3000

# Review storage: Upstash Redis (adding it from Vercel's Marketplace sets these for you).
# Either pair works. Without them, reviews are off in production and kept in
# memory when running `npm run dev`.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Moderator token for /moderate (at least 16 characters, keep it secret).
# REVIEWS_ADMIN_TOKEN=

# Optional: a long random string used to hash visitor IPs for rate limits.
# REVIEWS_SALT=

# Optional: set to "all" to hold every review until a moderator approves it.
# REVIEWS_MODERATION=
