# Optional. Student Atlas runs without any keys; these turn on shared reviews
# and College Lab AI feedback.
# PORT=3000

# Review storage: Upstash Redis (adding it from Vercel's Marketplace sets these for you).
# Either pair works. Without them, reviews are off in production and kept in
# memory when running `npm run dev`.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Moderator token for /moderate (at least 16 characters, keep it secret).
# REVIEWS_ADMIN_TOKEN=

# Optional: a long random string used to hash visitor IPs for rate limits.
# REVIEWS_SALT=

# Optional: set to "all" to hold every review until a moderator approves it.
# REVIEWS_MODERATION=

# College Lab AI feedback (essays, transcripts, mentor). Without a key the
# College Lab uses its on-device engine. Set these in Vercel under
# Settings -> Environment Variables; never commit a real key.
# ANTHROPIC_API_KEY=
# COLLEGE_LAB_MODEL=claude-opus-5-5
# COLLEGE_LAB_RATE_LIMIT=30
